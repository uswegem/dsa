# Copy this file to .env and fill in real values. .env is gitignored.

DATABASE_URL=postgresql+psycopg://dsa_app:CHANGE_ME@127.0.0.1:5432/dsa

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Where uploaded files are stored on disk (relative to project root, or absolute).
UPLOAD_DIR=uploads
